{
  "type": "container",
  "version": "v21",
  "appId": "com.domain.example.taon-dev",
  "overridePackagesOrder": [
    "tnp-core",
    "@taon-dev/i18n",
    "ng2-logger",
    "magic-renamer",
    "taon-type-sql",
    "typescript-class-helpers",
    "taon-typeorm",
    "lodash-walk-object",
    "json10",
    "ng2-rest",
    "taon",
    "incremental-compiler",
    "tnp-helpers",
    "isomorphic-region-loader",
    "@taon-dev/session",
    "@taon-dev/cloud",
    "tnp",
    "taon-storage",
    "static-columns",
    "taon-ui",
    "@taon-dev/core-docs",
    "@taon-dev/emails",
    "@taon-dev/vscode-plugin",
    "@taon-dev/api-workers",
    "@taon-dev/e-commerce",
    "@taon-dev/cms",
    "@taon-dev/analytics",
  ],

  "removeAfterPullingFromGit": [
    "tnp-config",
    "tnp-models",
    "json10-writer",
    "taon-electron-app",
  ],

  "resources": [],

  "packageJsonOverride": {
    "author": "Dariusz Filipiak",
    "description": "Description for taon-dev. Hello world!",
    "scripts": {},
  },
}
