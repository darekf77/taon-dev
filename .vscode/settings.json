    ".sass-cache": true,
    ".sourcemaps": true,
    ".DS_Store": true,
    "**/.DS_Store": true,
    "npm-debug.log": true,
    "yarn-error.log": true,
    "testem.log": true,
    "connect.lock": true,
    "node_modules": true,
    "libpeerconnection.log": true,
    "dist": true,
    "coverage": true,
    "Thumbs.db": true,
    "browser": true,
    "websql": true,
    "eslint-rules": true,
    "chrome-profiler-events*.json": true,
    "speed-measure-plugin*.json": true,
    "tmp*": true,
    "npm-debug.log*": true,
    "tmp-*": true,
    "dist*": true,
    "tsconfig*": true,
    "run.js": true,
    "index.js": true,
    "index.js.map": true,
    "index.d.ts": true,
    ".npmignore": true,
    ".npmrc": true,
    ".prettierrc": true,
    ".prettierignore": true,
    "update-vscode-package-json.js": true,
    ".editorconfig": true,
    "package.json": true,
    ".babelrc": true,
    "eslint.config.js": true,
    "protractor.conf.js": true,
    "karma.conf.js": true,
    ".prettierc": true,
    "angular.json": true,
    ".prettierrc.json": true,
    ".eslintrc.js": true,
    ".eslintrc.json": true,
    ".yarnrc": true,
    ".idea": true,
    "webpack.*": true,
    ".eslintrc*": true,
    "tslint.*": true,
    "!templates-subprojects/**/package.json": true,
    "dist-*": true,
    ".ai/examples": true,
    "sub-projects/**/tsconfig.json": true,
    "analytics.worktrees": true,
    "vpn-split.worktrees": true,
    "api-workers.worktrees": true,
    "baseline.worktrees": true,
    "node-cli-tester.worktrees": true,
    "cloud.worktrees": true,
    "cms.worktrees": true,
    "core-docs.worktrees": true,
    "e-commerce.worktrees": true,
    "emails.worktrees": true,
    "i18n.worktrees": true,
