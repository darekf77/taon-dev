  "search.exclude": {
    "bin": true,
    "local_release": true,
    "node_modules": true,
    ".build": true,
    ".vscode": true,
    "browser": true,
    "dist": true,
    "package-lock.json": true,
    "tmp-*": true,
    ".firedev": true,
    ".taon": true,
    ".tnp": true,
    "**/bin": true,
    "**/local_release": true,
    "**/node_modules": true,
    "**/.build": true,
    "**/.vscode": true,
    "**/browser": true,
    "**/dist": true,
    "**/package-lock.json": true,
    "projects": true,
    "dist-*": true,
    "**/dist-*": true,
    "*.rest": true,
    "**/*.rest": true,
    "**/tmp-*": true,
    "src/app.auto-gen-docs.md": true,
    "src/app.auto-gen-ver.js": true,
    ".ai": true,
    "databases": true,
    "**/databases": true,
    "sub-projects": true,
    "**/src/app.auto-gen-docs.md": true,
    "**/src/app.auto-gen-ver.js": true
  },

  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[json5]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "editor.rulers": [80, 120],

  "eslint.migration.2_x": "off",
  "eslint.enable": true,
  "prettier.enable": true,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.inlineSuggest.enabled": true,
  "tslint.autoFixOnSave": false,
  "tslint.enable": false,
  "tslint.alwaysShowRuleFailuresAsWarnings": false,
  "prettier.endOfLine": "auto",
  "git.ignoreLimitWarning": true,
  "search.useIgnoreFiles": false,

  "search.include": ["**/src/**"],

  "window.title": "npm/taon-dev () [ ${activeEditorShort}]",

  "json.schemas": [
    {
      "fileMatch": ["/docs-config.jsonc"],
      "url": "./docs-config.schema.json"
    },
    {
      "fileMatch": ["/taon.jsonc"],
      "url": "./taon-config.schema.json"
    }
  ],

  "files.watcherExclude": {
    "local_release/**": true,
    "tmp-*/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/dist-nocutsrc/**": true,
    "**/src/**": true
  },

  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[dockercompose]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "prettier.prettierPath": "./node_modules/prettier",
  "typescript.suggest.autoImports": false,
  "javascript.suggest.autoImports": false,

  "files.associations": {
    "tsconfig.json": "plaintext",
    "**/tsconfig.json": "plaintext",
    "**/tsconfig.*.json": "plaintext"
  },

  "search.followSymlinks": false
}
