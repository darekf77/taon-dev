    "taon-type-sql.worktrees": true,
    "taon-typeorm.worktrees": true,
    "taon-ui.worktrees": true,
    "testbench.worktrees": true,
    "tnp.worktrees": true,
    "tnp-core.worktrees": true,
    "tnp-helpers.worktrees": true,
    "typescript-class-helpers.worktrees": true,
    "ui.worktrees": true,
    "vscode-plugin.worktrees": true,
    "manager.worktrees": true,
    "eslint.config.ts": true,
    "taon-config.schema.json": true,
    "AGENTS.md": true,
    ".github/copilot-instructions.md": true,
    ".ai": true,
    "vitest.config-browser.ts": true,
    "vitest.config-backend.ts": true,
    "vitest.setup-browser.ts": true,
    "vitest-angular-resources.plugin.ts": true,
    "**/tmp-*": true,
    "**/dist*": true,
    "**/dist-*": true,
    "**/tmp*": true,
    "**/tsconfig*": true,
    "docs.worktrees": true,
    "baseline-docs.worktrees": true,
    "messenger.worktrees": true,
    "client-projects.worktrees": true
